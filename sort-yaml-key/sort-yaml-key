#!/usr/bin/env python3

import argparse
import sys

import yaml


def main():
    parser = argparse.ArgumentParser(
        description="Sort a YAML file by a specified key.",
        epilog="Ensure that the key exists in every item of the YAML file.",
    )
    parser.add_argument(
        "-f",
        "--filename",
        metavar="filename",
        type=str,
        required=True,
        help="the path to the YAML file",
    )
    parser.add_argument(
        "-k", "--key", metavar="key", type=str, required=True, help="the key to sort by"
    )

    args = parser.parse_args()

    try:
        with open(args.filename, "r") as file:
            data = yaml.safe_load(file)
    except FileNotFoundError:
        print(f"Error: file not found: {args.filename}", file=sys.stderr)
        sys.exit(1)

    if not isinstance(data, list):
        print(
            f"Error: expected a YAML list, got {type(data).__name__}", file=sys.stderr
        )
        sys.exit(1)

    try:
        data.sort(key=lambda x: x[args.key])
    except KeyError:
        print(f"Error: key '{args.key}' not found in all items", file=sys.stderr)
        sys.exit(1)

    # False sorts before True, so != pushes the sort key to index 0 in each mapping
    data = [
        dict(sorted(item.items(), key=lambda kv: kv[0] != args.key)) for item in data
    ]

    print(yaml.safe_dump(data, default_flow_style=False, sort_keys=False))


if __name__ == "__main__":
    main()
