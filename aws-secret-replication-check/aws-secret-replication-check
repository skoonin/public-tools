#!/usr/bin/env python3

"""
AWS Secrets Manager Replication Status Checker

Lists AWS Secrets Manager secrets and their replication status across regions.
"""

from typing import Any, Dict, List, Optional

import boto3
import typer
from botocore.exceptions import ClientError
from tabulate import tabulate

app = typer.Typer(
    help="AWS Secrets Manager Replication Status Checker",
)


def list_secrets_with_replication(region: str, profile: str) -> None:
    """
    List all secrets in AWS Secrets Manager and their replication status.

    Args:
        region (str): AWS region to query
        profile (str): AWS profile to use for authentication
    """
    # Initialize a session using the specified profile and region
    session = boto3.Session(profile_name=profile, region_name=region)
    client = session.client("secretsmanager")

    secrets: List[Dict[str, Any]] = []
    try:
        paginator = client.get_paginator("list_secrets")
        for page in paginator.paginate():
            secrets.extend(page.get("SecretList", []))
    except ClientError as e:
        print(f"Error listing secrets: {e}")
        return

    table_data: List[List[str]] = []
    for secret in secrets:
        arn: str = secret.get("ARN", "N/A")
        name: str = secret.get("Name", "N/A")

        try:
            describe_response: Dict[str, Any] = client.describe_secret(SecretId=arn)
            replication_status: Optional[List[Dict[str, str]]] = describe_response.get(
                "ReplicationStatus", None
            )

            if replication_status:
                replicas: List[str] = []
                for replica in replication_status:
                    region_name: str = replica.get("Region", "N/A")
                    status: str = replica.get("Status", "N/A")
                    replicas.append(f"{region_name} ({status})")
                replicas_str = ", ".join(replicas)
            else:
                replicas_str = "N/A"

        except ClientError as e:
            replicas_str = f"Error: {e}"

        table_data.append([name, arn, replicas_str])

    # Define table headers
    headers: List[str] = ["Secret Name", "ARN", "Replication Details"]

    # Print the table
    print(tabulate(table_data, headers=headers, tablefmt="grid"))


@app.command(
    no_args_is_help=True,
)
def check_replication(
    region: str = typer.Option(
        ..., "--region", "-r", help="AWS region to query (e.g. us-east-1)"
    ),
    profile: str = typer.Option(
        ..., "--profile", "-p", help="AWS profile to use for authentication"
    ),
) -> None:
    """
    Check the replication status of AWS Secrets Manager secrets.

    Lists all secrets in the specified AWS region and their replication status
    across different regions. Output is presented in a formatted table.
    """
    list_secrets_with_replication(region, profile)


if __name__ == "__main__":
    app()
