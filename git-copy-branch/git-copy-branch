#!/usr/bin/env python3

import argparse
import re
import subprocess
import sys

try:
    import git
except ImportError:
    print("Error: GitPython not installed. Run: pip install GitPython", file=sys.stderr)
    sys.exit(1)


def file_exists_in_branch(repo, branch, file_path):
    try:
        # The --name-only option makes the command return only the file name if the file exists.
        output = repo.git.ls_tree("-r", branch, "--name-only", file_path)
    except git.GitCommandError:
        return False

    # If the output is empty, the file does not exist.
    return output.strip() != ""


# Set up argument parser and add arguments
parser = argparse.ArgumentParser(
    description="Copy file changes from one branch to another using GitPython."
)
parser.add_argument("destination", help="The destination branch name.")
parser.add_argument(
    "--origin", default=None, help="The origin branch name (default: current branch)."
)
parser.add_argument(
    "--base", default=None, help="The base branch name (default: main)."
)
args = parser.parse_args()

print(
    f"Copying file changes from origin branch '{args.origin}' to destination branch '{args.destination}'...\n"
)

# Initialize the Git repository and get the origin and destination branches
repo = git.Repo(".")
if args.origin:
    origin_branch = args.origin
else:
    origin_branch = repo.active_branch.name
destination_branch_name = args.destination
if args.base:
    base_branch = args.base
else:
    # Determine the default branch of the repository
    remote_show_output = subprocess.run(
        ["git", "remote", "show", "origin"], capture_output=True, text=True
    ).stdout
    match = re.search(r"HEAD branch: ([\w-]+)", remote_show_output)
    if match:
        base_branch = match.group(1)
        print(f"- Using default branch '{base_branch}' as base branch.")
    else:
        print("ERROR: Could not determine the default branch of the repository.")
        exit(1)

# Check if the destination branch exists, and if not, create it from the base branch
if destination_branch_name not in repo.branches:
    print(
        f"- Creating destination branch '{destination_branch_name}' from base branch '{base_branch}'."
    )
    repo.git.checkout(base_branch, b=destination_branch_name)

# Get the list of modified, added, and deleted files from the origin branch compared to the base branch
diff_index = repo.commit(base_branch).diff(repo.commit(origin_branch))

modified_files = [item.b_path for item in diff_index.iter_change_type("M")]
added_files = [item.b_path for item in diff_index.iter_change_type("A")]
deleted_files = [item.a_path for item in diff_index.iter_change_type("D")]

# Checkout the destination branch
repo.git.checkout(destination_branch_name)

# Handle deleted files
for file in deleted_files:
    try:
        repo.git.rm(file)
    except git.exc.GitCommandError:
        print(f"File '{file}' not found in the destination branch. Skipping...")

# Commit the changes
if deleted_files:
    repo.index.commit(f"Deleted files: {deleted_files}")

# Checkout the modified and added files from the origin branch into the working directory
for file in modified_files + added_files:
    if file_exists_in_branch(repo, origin_branch, file):
        repo.git.checkout(origin_branch, file)

print(
    f"\nFile changes from origin branch '{origin_branch}' have been copied to destination branch '{destination_branch_name}'.\n"
)
print("The following files have been modified, added, or deleted:")
print(f"├── Modified files: {modified_files}")
print(f"├── Added files: {added_files}")
print(f"└── Deleted files: {deleted_files}")
