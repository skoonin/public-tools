#!/usr/bin/env bash

# Function to check if the installed awk is GNU Awk
is_gnu_awk() {
    awk --version 2>&1 | grep -q "GNU Awk"
}

# Function to check if the system is macOS
is_macos() {
    [[ "$(uname)" == "Darwin" ]]
}

# Check if the installed awk is GNU Awk
if ! is_gnu_awk; then
    if is_macos; then
        # On macOS, check for gawk
        if command -v gawk &> /dev/null; then
            AWK_CMD="gawk"
        else
            echo "Error: GNU Awk is not installed on your macOS system."
            echo "You can install it using Homebrew with the following command:"
            echo "brew install gawk"
            exit 1
        fi
    else
        # On non-macOS systems (assumed to be Linux), error out
        echo "Error: GNU Awk is not installed on your system."
        echo "Please install GNU Awk using your system's package manager and try again."
        exit 1
    fi
else
    AWK_CMD="awk"
fi

# Execute the AWK script with the appropriate command
$AWK_CMD '

# Function to process a single file
function process_file(filename) {
    if (filename !~ /\.tf$/) {
        print "Skipping non-Terraform file: " filename
        return
    }

    # Create a backup of the original file
    backup_file = filename ".bak"
    backup_number = 0
    while (system("test -f " backup_file) == 0) {
        backup_number++
        backup_file = sprintf("%s.bak-%02d", filename, backup_number)
    }
    system("cp " filename " " backup_file)
    print "Created backup: " backup_file

    # Read the file content
    content = ""
    while ((getline line < filename) > 0) {
        content = content line "\n"
    }
    close(filename)

    # Process the content (existing logic)
    split("", arr)
    split("", res)
    resource_type = ""
    block_counter = 0

    split(content, lines, "\n")
    for (i in lines) {
        $0 = lines[i]

        # Skip blank lines at the beginning of file
        if (!resource_type && length($0) == 0) continue

        # Existing switch statement and logic...
        switch ($0) {
            case /^[[:space:]]*(import|locals|moved|removed|terraform)[[:space:]]+{/:
                resource_type = $1
                resource_ident = resource_type "|" block_counter++
                break
            case /^[[:space:]]*(data|resource)[[:space:]]+("?[[:alnum:]_-]+"?[[:space:]]+){2}{/:
                resource_type = $1
                resource_subtype = $2
                resource_name = $3
                resource_ident = resource_type "|" resource_subtype "|" resource_name
                break
            case /^[[:space:]]*(check|module|output|provider|variable)[[:space:]]+"?[[:alnum:]_-]+"?[[:space:]]+{/:
                resource_type = $1
                resource_name = $2
                resource_ident = resource_type "|" resource_name
                break
        }
        arr[resource_ident] = arr[resource_ident] ? arr[resource_ident] RS $0 : $0
    }

    # Existing sorting and processing logic...
    IGNORECASE = 1
    asort(arr)

    for (item in arr) {
        split(arr[item], new_arr, RS)

        while (length(new_arr[length(new_arr)]) == 0) delete new_arr[length(new_arr)]

        new_arr[length(new_arr)+1] = RS

        for (line in new_arr) {
            gsub(/[[:space:]]+$/, "", new_arr[line])
            res[length(res)+1] = new_arr[line]
        }
    }

    while (length(res[1]) == 0) delete res[1]
    while (length(res[length(res)]) == 0) delete res[length(res)]

    # Write the processed content back to the file
    output = ""
    for (line in res) {
        output = output res[line] "\n"
    }
    print output > filename
    close(filename)

    print "Processed file: " filename
}

# Main script
BEGIN {
    if (ARGC < 2) {
        print "Usage: tf_sort <file|directory> [file2] [file3] ..."
        exit 1
    }

    for (i = 1; i < ARGC; i++) {
        if (system("test -d " ARGV[i]) == 0) {
            # If its a directory, process all .tf files in it
            cmd = "find " ARGV[i] " -name \"*.tf\""
            while ((cmd | getline file) > 0) {
                process_file(file)
            }
            close(cmd)
        } else if (system("test -f " ARGV[i]) == 0) {
            # If its a file, process it directly
            process_file(ARGV[i])
        } else {
            print "Error: " ARGV[i] " is not a valid file or directory"
        }
    }
}
' "$@"